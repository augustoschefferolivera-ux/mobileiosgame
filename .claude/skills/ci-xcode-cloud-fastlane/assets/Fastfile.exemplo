# Fastfile.exemplo — copie para fastlane/Fastfile e ajuste SCHEME/segredos. Ver references/fastlane-exemplos.md.
default_platform(:ios)

def api_key
  app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
                            key_content: ENV.fetch("ASC_KEY_P8"), in_house: false)
end

platform :ios do
  lane :beta do
    key = api_key
    sync_code_signing(type: "appstore", readonly: true, api_key: key)
    increment_build_number(build_number: latest_testflight_build_number(api_key: key) + 1)
    build_app(scheme: ENV.fetch("SCHEME", "MeuJogo"), export_method: "app-store", configuration: "Release")
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true, distribute_external: false)
  end

  lane :metadata do
    deliver(api_key: api_key, skip_binary_upload: true, skip_screenshots: true, submit_for_review: false, force: true)
  end

  lane :screenshots do
    deliver(api_key: api_key, skip_binary_upload: true, skip_metadata: true, submit_for_review: false,
            overwrite_screenshots: true, force: true)
  end
end
