# ~/.config/mobileiosgame/gpu.env — lido por scripts/gpu.sh (não versione o seu; este é o exemplo)
GPU_SSH_HOST=gpu                 # alias do ~/.ssh/config (ou user@host)
GPU_MODE=windows                 # windows (PowerShell/cmd nativo) | wsl (prefixa com wsl -e bash -lc)
GPU_WORKDIR='C:\gpu-work'        # pasta de trabalho na estação (em modo wsl use /home/<user>/gpu-work)
GPU_COMFY_PORT=8188              # porta do ComfyUI na estação
GPU_RSYNC=0                      # 1 só se houver rsync no destino (WSL2); 0 usa scp
