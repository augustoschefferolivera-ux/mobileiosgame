{
  "name": "vigilia-das-cinzas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vigília das Cinzas (Ashen Vigil) — fatia vertical \"Primeira Vigília\"",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:dados": "vitest run tests/dados.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.logica.json",
    "lint": "eslint .",
    "test:lint": "vitest run tests/lint.test.ts",
    "dev": "vite",
    "build": "vite build",
    "build:debug": "vite build --mode debug --outDir dist-debug",
    "e2e": "playwright test --project=taps-game",
    "verify": "scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
