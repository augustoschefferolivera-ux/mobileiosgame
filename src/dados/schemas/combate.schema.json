{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "combate.schema.json",
  "title": "Combate (src/dados/combate.json)",
  "description": "Só o que nenhum outro JSON tem: stamina, esquiva, aparo, congelamento, Poder, Postura Quebrada, Contra-ataque, gestos e, na F-007, o cancelar do Frasco, o Apagar, a mancha e a agregação da telemetria e, na F-008, a arena e a Fogueira (design/decisoes-F-006.md ET9; design/decisoes-F-007.md §14; B §3.4 e §3.5). Durações em passos de 60 Hz, exatas como em B; os gestos em ms e pt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "stamina",
    "esquiva",
    "aparo",
    "congelamento_passos",
    "poder_da_esquiva_perfeita",
    "postura_quebrada",
    "contra_ataque_passos",
    "contra_ataque_fator",
    "ataques_dos_inimigos",
    "frasco",
    "apagar",
    "mancha",
    "telemetria",
    "gestos",
    "arena",
    "fogueira"
  ],
  "properties": {
    "versao": {
      "type": "integer",
      "minimum": 1
    },
    "stamina": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custo_esquiva",
        "custo_aparo",
        "regeneracao_por_passo",
        "espera_regeneracao_passos",
        "devolucao_do_aparo"
      ],
      "properties": {
        "custo_esquiva": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "custo_aparo": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "regeneracao_por_passo": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "espera_regeneracao_passos": {
          "type": "integer",
          "minimum": 1
        },
        "devolucao_do_aparo": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "esquiva": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duracao_passos",
        "iframes_primeiro_passo",
        "iframes_ultimo_passo",
        "recuperacao_passos",
        "distancia_px"
      ],
      "properties": {
        "duracao_passos": {
          "type": "integer",
          "minimum": 1
        },
        "iframes_primeiro_passo": {
          "type": "integer",
          "minimum": 1
        },
        "iframes_ultimo_passo": {
          "type": "integer",
          "minimum": 1
        },
        "recuperacao_passos": {
          "type": "integer",
          "minimum": 1
        },
        "distancia_px": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "aparo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "janela_passos",
        "janela_tutorial_extra_passos",
        "falho_passos"
      ],
      "properties": {
        "janela_passos": {
          "type": "integer",
          "minimum": 1
        },
        "janela_tutorial_extra_passos": {
          "type": "integer",
          "minimum": 0
        },
        "falho_passos": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "congelamento_passos": {
      "type": "integer",
      "minimum": 1
    },
    "poder_da_esquiva_perfeita": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pct",
        "duracao_passos"
      ],
      "properties": {
        "pct": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duracao_passos": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ataques_dos_inimigos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alcance_de_tiro_novica_corpos"
      ],
      "properties": {
        "alcance_de_tiro_novica_corpos": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "postura_quebrada": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duracao_passos",
        "raio_px",
        "dano_pct"
      ],
      "properties": {
        "duracao_passos": {
          "type": "integer",
          "minimum": 1
        },
        "raio_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dano_pct": {
          "type": "integer",
          "minimum": 100
        }
      }
    },
    "contra_ataque_passos": {
      "type": "integer",
      "minimum": 1
    },
    "contra_ataque_fator": {
      "type": "integer",
      "minimum": 1
    },
    "frasco": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancelar_segurando_passos"
      ],
      "properties": {
        "cancelar_segurando_passos": {
          "description": "Passos que um novo toque no botão do Frasco precisa durar para cancelar a cura (FR6; a calibrar no iPhone, F-010).",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "apagar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duracao_passos",
        "camera_lenta_fator"
      ],
      "properties": {
        "duracao_passos": {
          "description": "Passos de APAGANDO até FIM (AG2).",
          "type": "integer",
          "minimum": 1
        },
        "camera_lenta_fator": {
          "description": "Escala do deltaMs do driver enquanto a fase for APAGANDO (só apresentação).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "mancha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pct_das_almas",
        "raio_px",
        "margem_dos_obstaculos_px"
      ],
      "properties": {
        "pct_das_almas": {
          "description": "Parte das Almas da Vigília que fica na mancha no Apagar (MC1).",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "raio_px": {
          "description": "Distância toroidal, de centro a centro, em que encostar devolve as Almas (MC7).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "margem_dos_obstaculos_px": {
          "description": "Folga somada ao raio do obstáculo na zona proibida da posição da mancha (MC4).",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "telemetria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agregacao_do_contato_s",
        "teto_por_fonte"
      ],
      "properties": {
        "agregacao_do_contato_s": {
          "description": "Janela, em segundos, em que o dano de contato vira uma só linha de dano_recebido (TL1).",
          "type": "integer",
          "minimum": 1
        },
        "teto_por_fonte": {
          "description": "Linhas de dano_recebido, esquiva, aparo e frasco que cada fonte guarda (anel por fonte; TL1).",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gestos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "swipe",
        "toque_duplo"
      ],
      "properties": {
        "swipe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "velocidade_min_pt_s",
            "janela_ms",
            "dt_min_ms",
            "distancia_min_pt",
            "amostras"
          ],
          "properties": {
            "velocidade_min_pt_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "janela_ms": {
              "type": "integer",
              "minimum": 1
            },
            "dt_min_ms": {
              "type": "integer",
              "minimum": 1
            },
            "distancia_min_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "amostras": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        },
        "toque_duplo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intervalo_max_ms",
            "duracao_max_ms",
            "distancia_entre_toques_max_pt",
            "deslocamento_max_pt"
          ],
          "properties": {
            "intervalo_max_ms": {
              "type": "integer",
              "minimum": 1
            },
            "duracao_max_ms": {
              "type": "integer",
              "minimum": 1
            },
            "distancia_entre_toques_max_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "deslocamento_max_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "arena": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raio_px"
      ],
      "properties": {
        "raio_px": {
          "description": "Raio da arena do marco, de centro a centro, no toro (AR2).",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "fogueira": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raio_px",
        "distancia_px"
      ],
      "properties": {
        "raio_px": {
          "description": "Raio em que a Fogueira abre, de centro a centro (FG2).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "distancia_px": {
          "description": "Distância do jogador em que a Fogueira acende no fim do marco (FG1).",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
