{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "passiva.schema.json",
  "title": "Passivas (src/dados/passivas.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "passivas"],
  "properties": {
    "versao": { "type": "integer", "minimum": 1 },
    "passivas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nome_id", "efeito_id", "lore_id", "deus", "nivel_max", "efeito_por_nivel"],
        "properties": {
          "id": { "$ref": "comum.schema.json#/$defs/idConteudo" },
          "nome_id": { "$ref": "comum.schema.json#/$defs/idTexto" },
          "efeito_id": { "$ref": "comum.schema.json#/$defs/idTexto" },
          "lore_id": { "$ref": "comum.schema.json#/$defs/idTexto" },
          "deus": { "$ref": "comum.schema.json#/$defs/deus" },
          "nivel_max": { "type": "integer", "minimum": 1, "maximum": 5 },
          "efeito_por_nivel": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "valor"],
            "properties": {
              "tipo": { "enum": ["armadura", "poder_pct"] },
              "valor": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
