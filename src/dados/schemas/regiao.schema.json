{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regiao.schema.json",
  "title": "Região e timeline do diretor (src/dados/regioes/*.json)",
  "description": "Uma linha por minuto (B §3.7; brief §5.4; ADR-0002 §8 e Apêndice A).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nome_id", "sem_spawn_antes_do_marco_s", "a_fome_em_s", "inicio_jogador", "obstaculos", "linhas"],
  "properties": {
    "id": { "$ref": "comum.schema.json#/$defs/idConteudo" },
    "nome_id": { "$ref": "comum.schema.json#/$defs/idTexto" },
    "sem_spawn_antes_do_marco_s": { "type": "number", "minimum": 0 },
    "a_fome_em_s": { "type": "number", "exclusiveMinimum": 0 },
    "inicio_jogador": {
      "description": "Onde o jogador começa a Vigília, em px lógicos do toro 1.170 × 2.532 (design/decisoes-F-002.md §5).",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "exclusiveMaximum": 1170 },
        "y": { "type": "number", "minimum": 0, "exclusiveMaximum": 2532 }
      }
    },
    "obstaculos": {
      "description": "Disposição fixa por mapa (Q-04), 4 a 8 por tela (B F-002). Só círculos; (x, y) é o centro e tamanho_px o diâmetro (design/decisoes-F-002.md §2). As regras da disposição ficam em tests/disposicao.test.ts; ela foi gerada por scripts/gerar-disposicao.py.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "forma", "tamanho_px"],
        "properties": {
          "x": { "type": "number", "minimum": 0, "exclusiveMaximum": 1170 },
          "y": { "type": "number", "minimum": 0, "exclusiveMaximum": 2532 },
          "forma": { "enum": ["circulo"] },
          "tamanho_px": { "enum": [64, 80, 96] }
        }
      }
    },
    "linhas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/linha" }
    }
  },
  "$defs": {
    "entradaRoster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inimigo", "peso"],
      "properties": {
        "inimigo": { "$ref": "comum.schema.json#/$defs/idConteudo" },
        "peso": { "description": "Peso inteiro do sorteio (design/decisoes-F-003.md §4).", "type": "integer", "minimum": 1 }
      }
    },
    "linha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minuto", "roster", "min_na_tela", "intervalo_s"],
      "properties": {
        "minuto": { "type": "integer", "minimum": 0 },
        "roster": { "type": "array", "items": { "$ref": "#/$defs/entradaRoster" } },
        "min_na_tela": { "type": "integer", "minimum": 0 },
        "intervalo_s": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "escurecer_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "garantidos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inimigo", "quantidade"],
            "properties": {
              "inimigo": { "$ref": "comum.schema.json#/$defs/idConteudo" },
              "quantidade": { "type": "integer", "minimum": 1 },
              "tutorial": { "enum": ["esquiva", "aparo"] }
            }
          }
        },
        "marco": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tipo", "indice", "inimigos", "bau"],
          "properties": {
            "tipo": { "enum": ["guardiao", "chefe_menor"] },
            "indice": { "type": "integer", "minimum": 1 },
            "inimigos": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["inimigo", "hp_base", "quantidade"],
                "properties": {
                  "inimigo": { "$ref": "comum.schema.json#/$defs/idConteudo" },
                  "hp_base": { "type": "number", "exclusiveMinimum": 0 },
                  "quantidade": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "bau": { "enum": ["comum", "dourado"] }
          }
        },
        "chefe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inimigo", "hp_base"],
          "properties": {
            "inimigo": {
              "description": "ID em chefes.json.",
              "$ref": "comum.schema.json#/$defs/idConteudo"
            },
            "hp_base": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
