{
  "mcpServers": {
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-for-blender"]
    },
    "elevenlabs": {
      "type": "http",
      "url": "https://api.elevenlabs.io/v1/mcp",
      "headers": {
        "xi-api-key": "${ELEVENLABS_API_KEY}"
      }
    }
  }
}
