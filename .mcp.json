{
  "mcpServers": {
    "xcode": {
      "type": "stdio",
      "command": "xcrun",
      "args": ["mcpbridge"]
    },
    "mobilebuild": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mobilebuildmcp@latest", "mcp"]
    },
    "ios-simulator": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "ios-simulator-mcp@latest"]
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-for-blender"]
    },
    "elevenlabs": {
      "type": "http",
      "url": "https://api.elevenlabs.io/v1/mcp",
      "headers": {
        "xi-api-key": "${ELEVENLABS_API_KEY}"
      }
    }
  }
}
